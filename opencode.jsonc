{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "angular-architect",
  "experimental": {
    "subagent_depth": 2
  },
  "formatter": {
    "oxfmt": {
      "command": ["pnpm", "exec", "oxfmt", "$FILE"],
      "extensions": [".ts"]
    }
  },
  "mcp": {
    "servers": {
      "angular-cli": {
        "command": ["pnpm", "exec", "ng", "mcp"],
        "type": "local"
      },
      "ngp-mcp": {
        "command": ["pnpm", "exec", "ngp-mcp"],
        "type": "local"
      },
      "Figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  }
}
