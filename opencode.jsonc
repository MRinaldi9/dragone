{
  // "$schema": "https://opencode.ai/config.json",
  "default_agent": "angular-architect",
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "oxfmt": {
      "command": ["pnpm", "format"],
      "extensions": [".ts"]
    }
  },
  "mcp": {
    "servers": {
      "angular-cli": {
        "command": ["pnpm", "exec", "ng", "mcp"],
        "type": "local"
      },
      "ngp-mcp": {
        "command": ["pnpm", "exec", "ngp-mcp"],
        "type": "local"
      },
      "figma": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  }
}
