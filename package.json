{
  "name": "dragone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint:oxlint && pnpm lint:eslint && pnpm lint:docs",
    "lint:docs": "node scripts/check-links.ts",
    "lint:eslint": "ng lint",
    "lint:oxlint": "oxlint",
    "lint:package": "pnpm build @dragone/ui && publint dist/dragone/ui",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "commit": "cz",
    "storybook": "ng run @dragone/ui:storybook",
    "build-storybook": "ng run @dragone/ui:build-storybook"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@floating-ui/dom": "^1.8.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/font-awesome": "^36.1.0",
    "@ng-primitives/mcp": "^0.131.0",
    "ng-primitives": "^0.131.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "^2.7.5",
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/angular": "10.6.0",
    "@types/node": "^24.12.0",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "@wismaz/vitest-browser-angular": "^1.0.0",
    "angular-eslint": "22.5.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "^1.85.0",
    "eslint-plugin-storybook": "10.6.0",
    "lefthook": "^2.1.14",
    "ng-packagr": "^22.2.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "storybook": "10.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0 || ^26",
      "onFail": "error"
    }
  }
}
