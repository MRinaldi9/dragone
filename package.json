{
  "name": "dragone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "lint": "pnpm lint:all",
    "lint:docs": "node scripts/check-links.ts",
    "lint:eslint": "ng lint",
    "lint:oxlint": "oxlint",
    "lint:package": "pnpm build @dragone/ui && publint dist/dragone/ui",
    "lint:css": "stylelint projects/**/*.css",
    "lint:all": "pnpm lint:oxlint && pnpm lint:eslint && pnpm lint:css && pnpm lint:docs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "commit": "cz",
    "storybook": "ng run @dragone/ui:storybook",
    "build-storybook": "ng run @dragone/ui:build-storybook"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@floating-ui/dom": "^1.8.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/font-awesome": "^36.1.0",
    "@ng-primitives/mcp": "^0.131.4",
    "ng-primitives": "^0.131.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.5",
    "@analogjs/vitest-angular": "^2.9.5",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-onboarding": "10.6.5",
    "@storybook/angular-vite": "^10.6.5",
    "@types/node": "^24.12.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@wismaz/vitest-browser-angular": "^2.0.0",
    "angular-eslint": "22.6.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-storybook": "10.6.5",
    "lefthook": "^2.2.2",
    "ng-packagr": "^22.2.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "storybook": "10.6.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0 || ^26",
      "onFail": "error"
    }
  }
}
