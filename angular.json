{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "path": "projects/dragone/ui"
    },
    "@schematics/angular:directive": {
      "path": "projects/dragone/ui"
    },
    "@schematics/angular:pipe": {
      "path": "projects/dragone/ui"
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "@dragone/ui": {
      "projectType": "library",
      "root": "projects/dragone/ui",
      "sourceRoot": "projects/dragone/ui",
      "prefix": "drgn",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/dragone/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/dragone/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@analogjs/vitest-angular:test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/dragone/ui/**/*.ts",
              "projects/dragone/ui/**/*.html"
            ],
            "eslintConfig": "projects/dragone/ui/eslint.config.mjs"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": ".storybook",
            "port": 6006,
            "styles": ["projects/dragone/ui/src/main.css"]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": ".storybook",
            "outputDir": "dist/storybook",
            "styles": ["projects/dragone/ui/src/main.css"]
          }
        }
      }
    }
  }
}
